{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    },
    "WriteTo": {
      "Debug": { "Name": "Debug" }
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=hrastErp;Username=postgres;Password=postgres",
    "SeedFixtures": true
  },
